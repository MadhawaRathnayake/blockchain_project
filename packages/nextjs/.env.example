# NextJS environment variables. Copy this file to .env.local and fill in the values.
#
# NEXT_PUBLIC_ vars are exposed to the browser; everything else stays server-side.

NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# ── Chain ────────────────────────────────────────────────────────────────────
# The local Hardhat node started by `yarn chain`. These are also the defaults
# when unset.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Server-side RPC override (no NEXT_PUBLIC_). Optional — falls back to
# NEXT_PUBLIC_RPC_URL. Set it when the Next.js server reaches the node at a
# different address than the browser does (e.g. a container hostname).
RPC_URL=

# Optional NicRegistry override. Leave EMPTY: the address is read from
# contracts/deployedContracts.ts. Only set this to point at a registry deployed
# outside `yarn deploy`.
NEXT_PUBLIC_NIC_REGISTRY_ADDRESS=

# ── Dev faucet (SERVER-side) ─────────────────────────────────────────────────
# Chain ids /api/faucet is willing to fund on. It signs with a well-known public
# test key, so it must never be enabled on a real network.
FAUCET_CHAIN_IDS=31337

# ── Hashed-NIC registry (SERVER-side only — never expose this to the browser) ─
# Long random secret used to hash NICs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_PEPPER=
