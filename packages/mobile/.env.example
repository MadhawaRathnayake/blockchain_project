# Mobile app environment. Copy this file to .env.
#
# Replace 172.20.10.10 with your dev machine's LAN IP (the one `expo start`
# prints). `localhost` does not work from a phone or the Android emulator.

# The Next.js web app (yarn start)
EXPO_PUBLIC_API_URL=http://172.20.10.10:3000
# The Hardhat node (yarn chain)
EXPO_PUBLIC_RPC_URL=http://172.20.10.10:8545
EXPO_PUBLIC_CHAIN_ID=31337
